<?xml version="1.0" encoding="utf-8"?>
<!-- واجهة تحكم المشغل: شريط علوي (رجوع، اسم القناة، مباشر)، أزرار وسطية، وشريط أدوات سفلي -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="locale">

    <View
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:layout_gravity="top"
        android:background="@drawable/bg_top_scrim" />

    <View
        android:layout_width="match_parent"
        android:layout_height="160dp"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_bottom_scrim" />

    <!-- الشريط العلوي -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingTop="18dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_control_btn"
            android:contentDescription="@string/cancel"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_arrow_back" />

        <ImageView
            android:id="@+id/ivOverlayLogo"
            android:layout_width="64dp"
            android:layout_height="40dp"
            android:layout_marginStart="12dp"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvOverlayChannelName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAlignment="viewStart"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvOverlayNetwork"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAlignment="viewStart"
                android:textColor="#B3FFFFFF"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvLiveBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_live_badge"
            android:paddingHorizontal="10dp"
            android:paddingVertical="3dp"
            android:text="@string/live"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- أزرار وسطية: السابقة / تشغيل-إيقاف / التالية -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:layoutDirection="ltr"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnPrevChannel"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:background="@drawable/bg_control_btn"
            android:contentDescription="@string/channels"
            android:padding="14dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_skip_prev" />

        <ImageButton
            android:id="@+id/btnPlayPause"
            android:layout_width="84dp"
            android:layout_height="84dp"
            android:layout_marginHorizontal="36dp"
            android:background="@drawable/bg_play_btn"
            android:contentDescription="@string/live"
            android:padding="20dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_pause" />

        <ImageButton
            android:id="@+id/btnNextChannel"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:background="@drawable/bg_control_btn"
            android:contentDescription="@string/next_channel"
            android:padding="14dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_skip_next" />
    </LinearLayout>

    <!-- شريط الأدوات السفلي -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingBottom="20dp">

        <LinearLayout style="@style/PlayerTool">
            <ImageButton
                android:id="@+id/btnChannels"
                style="@style/PlayerToolButton"
                android:contentDescription="@string/channels"
                android:src="@drawable/ic_list" />
            <TextView style="@style/PlayerToolLabel" android:text="@string/channels" />
        </LinearLayout>

        <LinearLayout style="@style/PlayerTool">
            <ImageButton
                android:id="@+id/btnReload"
                style="@style/PlayerToolButton"
                android:contentDescription="@string/retry"
                android:src="@drawable/ic_refresh" />
            <TextView style="@style/PlayerToolLabel" android:text="@string/retry" />
        </LinearLayout>

        <LinearLayout style="@style/PlayerTool">
            <ImageButton
                android:id="@+id/btnAspect"
                style="@style/PlayerToolButton"
                android:contentDescription="@string/resize_fit"
                android:src="@drawable/ic_aspect" />
            <TextView
                android:id="@+id/tvAspect"
                style="@style/PlayerToolLabel"
                android:text="@string/resize_fit" />
        </LinearLayout>

        <LinearLayout style="@style/PlayerTool">
            <ImageButton
                android:id="@+id/btnExternal"
                style="@style/PlayerToolButton"
                android:contentDescription="@string/external_player"
                android:src="@drawable/ic_open_external" />
            <TextView style="@style/PlayerToolLabel" android:text="@string/external_player" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
