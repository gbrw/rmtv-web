<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/rmtvBackground">

    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="24dp"
        android:paddingBottom="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <!-- App Logo - Changed from ic_launcher to ic_tv to be correct -->
        <ImageView
            android:id="@+id/ivAppLogo"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="16dp"
            android:contentDescription="شعار التطبيق"
            android:src="@mipmap/ic_launcher" />

        <!-- Centered RMTV Logo -->
        <TextView
            android:id="@+id/tvAppTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="RMTV"
            android:textSize="28sp"
            android:textStyle="bold|italic"
            android:gravity="center"
            android:textColor="?attr/rmtvAccent"
            android:fontFamily="sans-serif"/>

        <!-- إعداد المشغل الافتراضي (داخلي / VLC / MX ...) -->
        <ImageButton
            android:id="@+id/btnSettings"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_control_btn"
            android:contentDescription="@string/settings"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_settings"
            app:tint="?attr/rmtvText" />

    </LinearLayout>

    <EditText
        android:id="@+id/etSearch"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="16dp"
        android:hint="ابحث عن باقتك المفضلة..."
        android:textColorHint="?attr/rmtvTextSecondary"
        android:textColor="?attr/rmtvText"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:background="@drawable/search_box_background"
        android:drawableEnd="@drawable/ic_search"
        android:drawableTint="?attr/rmtvTextSecondary"
        android:drawablePadding="12dp"
        android:imeOptions="actionSearch"
        android:inputType="text"
        android:maxLines="1"
        android:nextFocusDown="@id/rvNetworks"
        app:layout_constraintTop_toBottomOf="@id/headerLayout"/>

    <TextView
        android:id="@+id/tvPackagesTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="24dp"
        android:text="اختر باقتك"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="?attr/rmtvText"
        app:layout_constraintTop_toBottomOf="@id/etSearch"/>

    <TextView
        android:id="@+id/tvPackagesSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="4dp"
        android:text="استمتع بأفضل التغطيات الرياضية العالمية والمحلية"
        android:textSize="12sp"
        android:textColor="?attr/rmtvTextSecondary"
        app:layout_constraintTop_toBottomOf="@id/tvPackagesTitle"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvNetworks"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="16dp"
        android:paddingBottom="24dp"
        android:clipToPadding="false"
        android:descendantFocusability="afterDescendants"
        android:scrollbars="vertical"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintTop_toBottomOf="@id/tvPackagesSubtitle"
        app:layout_constraintBottom_toBottomOf="parent"/>

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/tvError"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#FF5252"
        android:textSize="18sp"
        android:visibility="gone"
        android:gravity="center"
        android:layout_margin="32dp"
        android:textAlignment="center"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>