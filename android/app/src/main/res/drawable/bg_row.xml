<?xml version="1.0" encoding="utf-8"?>
<!-- خلفية الصفوف: ألوانها من الثيم، وإطار باللون الرئيسي عند التركيز بالريموت -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/rmtvRowFocused" />
            <stroke android:width="2dp" android:color="?attr/rmtvAccent" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/rmtvRowFocused" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/rmtvRow" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>