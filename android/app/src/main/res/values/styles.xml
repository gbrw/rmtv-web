<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Main App Theme -->
    <style name="Theme.RMTV" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_dark</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="colorSecondaryVariant">@color/accent</item>
        <item name="colorError">#FF5252</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="colorOnSecondary">@android:color/white</item>
        <item name="colorOnError">@android:color/white</item>
        <item name="colorOnSurface">@color/text_primary</item>

        <item name="android:windowBackground">@color/surface</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:windowLightStatusBar">false</item>

        <!-- القيم الافتراضية للثيم (داكن + سماوي)، تتغير عبر ThemeManager -->
        <item name="rmtvAccent">@color/primary</item>
        <item name="rmtvBackground">#0F1419</item>
        <item name="rmtvRow">#161D27</item>
        <item name="rmtvRowFocused">#1F2A3A</item>
        <item name="rmtvLogoBox">#0D131A</item>
        <item name="rmtvSearchBg">#1A1A2E</item>
        <item name="rmtvStroke">#333333</item>
        <item name="rmtvText">#FFFFFF</item>
        <item name="rmtvTextSecondary">#999999</item>
    </style>

    <!-- شاشة المشغل: خلفية سوداء بدون أشرطة النظام -->
    <style name="Theme.RMTV.Player">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="p">shortEdges</item>
    </style>

    <!-- أدوات الشريط السفلي في المشغل -->
    <style name="PlayerTool">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">14dp</item>
        <item name="android:layout_marginEnd">14dp</item>
        <item name="android:gravity">center_horizontal</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="PlayerToolButton">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:background">@drawable/bg_control_btn</item>
        <item name="android:padding">12dp</item>
        <item name="android:scaleType">fitCenter</item>
    </style>

    <style name="PlayerToolLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:textColor">#CCFFFFFF</item>
        <item name="android:textSize">11sp</item>
    </style>

    <!-- Leanback Browse Theme for TV -->
    <style name="Theme.Leanback.Browse" parent="@style/Theme.Leanback">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_dark</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="android:windowBackground">@color/surface</item>
    </style>

</resources>
