rules_version = '2';

// القراءة متاحة للجميع (التطبيق ونسخة الويب)، والتعديل لحسابات Google المدرجة فقط.
// عند إضافة مدير جديد: أضف بريده هنا وفي pwa/config.js (ADMIN_EMAILS) ثم انشر الاثنين.
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in ['gaithalrawi99@gmail.com'];
    }

    match /networks/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /channels/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
